--- a/kommon.c
+++ b/kommon.c
@@ -340,6 +340,42 @@
  * mmap loader *
  ***************/
 
+#if defined(WIN32) || defined(_WIN32)
+
+void *kom_mmap_file(const char *fn, size_t *len, int preload)
+{
+	HANDLE file, mapping;
+	LARGE_INTEGER size;
+	void *base;
+
+	(void)preload;
+	*len = 0;
+	file = CreateFileA(fn, GENERIC_READ, FILE_SHARE_READ, 0, OPEN_EXISTING,
+	                   FILE_ATTRIBUTE_NORMAL | FILE_FLAG_RANDOM_ACCESS, 0);
+	if (file == INVALID_HANDLE_VALUE) return 0;
+	if (!GetFileSizeEx(file, &size) || size.QuadPart <= 0 ||
+	    (uint64_t)size.QuadPart > (uint64_t)SIZE_MAX) {
+		CloseHandle(file);
+		return 0;
+	}
+	mapping = CreateFileMappingA(file, 0, PAGE_READONLY, 0, 0, 0);
+	CloseHandle(file);
+	if (mapping == 0) return 0;
+	base = MapViewOfFile(mapping, FILE_MAP_READ, 0, 0, 0);
+	CloseHandle(mapping);
+	if (base == 0) return 0;
+	*len = (size_t)size.QuadPart;
+	return base;
+}
+
+int kom_munmap(void *base, size_t map_len) // a simple wrapper
+{
+	(void)map_len;
+	return UnmapViewOfFile(base)? 0 : -1;
+}
+
+#else
+
 #include <fcntl.h>
 #include <unistd.h>
 #include <sys/mman.h>
@@ -372,3 +408,5 @@
 {
 	return munmap(base, map_len);
 }
+
+#endif /* WIN32 || _WIN32 */
